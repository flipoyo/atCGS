# The USR tree for atCGS (ComplexGraphSync), one of cgs-{opx,dev,usr}.cgs.
# Each file is named for the level it installs; the project is still POEX, on main,
# so no branch has to exist for any level. POEX.cgs at the root is the PUB install.
# USR: atCGS and its engine, nothing private. A USER tree never mounts .omniscience:
# the register is held by the gate, and USR reads only its PUBLIC answer (@cgs PUB).
#   .computo      ComplexGitSync, mounted with its own USR tree (complexgitsync-usr.cgs)
#     pixi run cgitsync bootstrap examples/cgs-usr.cgs POEX

environment_root = "root"
environment = { tools = { python = "3.11", git = "2.30", pixi = "0.65" }, manifests = ["pixi.toml"] }

project = { name = "POEX", default_branch = "main" }

repos = [
    { repository = "github:flipoyo/atCGS", fallback_branch = "main", nested_config = "disabled" },
    { repository = "github:flipoyo/ComplexGitSync", relative_path = ".computo", fallback_branch = "main", nested_config = "examples/complexgitsync-usr.cgs" },
]
